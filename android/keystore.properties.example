# Copy to android/keystore.properties (gitignored). Read by android/app/build.gradle
# for the release signingConfig. Paths are relative to the android/ directory.
#
# This is the Play UPLOAD key. With Play App Signing on (the default for any app
# created after August 2021) Google holds the real app-signing key and this key
# only authenticates uploads; if it is lost it can be reset through Play Console
# support. If the listing predates Play App Signing, this file must point at the
# ORIGINAL keystore the store app was signed with, or the update is rejected.
#
# Never commit the .jks or this file. Keep both in a password manager.
storeFile=ingo-upload.jks
storePassword=
keyAlias=ingo-upload
keyPassword=
