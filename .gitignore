# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# misc
.DS_Store
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Vendor tarballs (avoid committing large archives)
*.tgz

# Local Paynow Node server deps
/server/node_modules
/server/.env

# Firebase
.firebase
*-debug.log

# Push testing, local only.
# .secrets/ holds an FCM service-account private key. Never commit it.
.secrets/
# google-services.json here is a THROWAWAY test-project file, so it stays out of
# the repo. The real one for the store builds is supplied by KIGATTA and belongs
# wherever the shipped apps are actually built. See docs/push-local-testing.md.
android/app/google-services.json

# Supabase CLI working files (project-ref cache from `functions deploy`)
supabase/.temp/

# Android release signing. The upload keystore and its passwords never enter the
# repo; android/app/build.gradle reads android/keystore.properties at build time
# (template: android/keystore.properties.example).
android/keystore.properties
*.jks
*.keystore

# Public certificate of the upload key, for the Play upload-key reset form. Not secret, not repo content.
android/*.pem
